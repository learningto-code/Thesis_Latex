\usepackage{soul} % for enabling highlight feature through \hl{ } command

% Make \texttt{} content breakable at underscores, slashes, dots, and dashes so long
% code identifiers (fuel_level_filtered, /tel_buf.log, route_segment_performance, etc.)
% never overflow the right border of a paragraph, table cell, or shaded revhl block.
\makeatletter
\let\SG@origtexttt\texttt
\renewcommand*{\texttt}[1]{%
  \begingroup
    \def\_{\discretionary{}{}{}\char`_\discretionary{}{}{}}%
    \SG@origtexttt{#1}%
  \endgroup
}
\makeatother

% Give LaTeX permission to stretch inter-word spacing on the last line of a
% paragraph before it overflows the right margin. This catches the residual
% cases where camelCase identifiers (postRefuel, coldStartSuppress) and other
% unbreakable inline code names would otherwise push into or past the border.
\setlength{\emergencystretch}{3em}
\soulregister{\ref}{1}
\soulregister{\cite}{1}
\soulregister{\pageref}{1}
\soulregister{\eqref}{1}
\soulregister{\gls}{1}
\soulregister{\glsadd}{1}
\soulregister{\texttt}{1}

% Yellow-shaded block environment for large revision blocks. Uses mdframed
% for mid-paragraph page splitting. lineno's per-line numbering interacts
% badly with framed environments (each numbered line becomes its own
% page-break candidate, producing one-line-per-page rendering), so revhl
% suspends lineno inside the block and restores it after.
\usepackage{mdframed}
\definecolor{revhlcolor}{RGB}{255,241,153}
\newmdenv[
  hidealllines=true,
  backgroundcolor=revhlcolor,
  innertopmargin=1pt,
  innerbottommargin=1pt,
  innerleftmargin=2pt,
  innerrightmargin=2pt,
  skipabove=2pt,
  skipbelow=2pt
]{revhl@inner}
\newenvironment{revhl}%
  {\par\nolinenumbers\begin{revhl@inner}\sloppy}%
  {\end{revhl@inner}\linenumbers\par}

