\usepackage[]{hyperref} % for hyperlinking

% \stdlink{bibkey}{display} renders `display' as a clickable link that jumps to
% the bibliography entry for `bibkey' (used to make standard names in the
% standards-mapping table hyperlink back to the References section). \nocite
% ensures the key is present in the bibliography even when the discussion prose
% below the table does not re-cite it explicitly.
\newcommand{\stdlink}[2]{\nocite{#1}\hyperlink{cite.#1}{#2}}

% \seclink{label}{display} renders `display' as a clickable link that jumps to
% the section marked by `\label{label}'. Used in the standards-mapping table's
% "Implemented In" column so a reader can press "Secs.~5.3, 5.4.1--5.4.4" and
% land on the corresponding section in Chapter~5.
\newcommand{\seclink}[2]{\hyperref[#1]{#2}}

\usepackage{url} % for providing better support for handling and breaking URLs

% Render \doi{X} as a full clickable URL "https://doi.org/X" (matches the
% https://doi.org/10.xxxx presentation requested in the citation-format
% guidance), rather than the "doi:X" prefix produced by the doi package
% defaults. Suppresses the apacite "doi:" label (\doiprefix) that would
% otherwise appear before the URL inside the APACrefDOI environment.
\makeatletter
\renewcommand*{\doi}[1]{\href{https://doi.org/#1}{https://doi.org/#1}}
\@ifundefined{doiprefix}{}{\renewcommand{\doiprefix}{}}
\makeatother

% Inside the apacite APACrefURL environment ("Retrieved from ..."), suppress
% \url and its preceding "Retrieved from" prefix when the URL is a doi.org
% resolver, since the DOI field already renders as an https://doi.org/... URL
% via the \doi override above. This keeps the article's IEEEtran bibliography
% (which reads the url field to render DOIs) working without producing a
% duplicated "Retrieved from https://doi.org/... https://doi.org/..." line
% in the apacite bibliography of the main thesis. Implemented with plain
% TeX pattern matching (no xstring dependency).
\makeatletter
% Sentinel token used to detect "no substring match" in \SG@ifhasDoiOrg.
% After the scan, \SG@doiTail is set to whatever follows the first "doi.org"
% in the input, up to \SG@doiEnd. If the input contains no "doi.org", the
% scan matches only the appended sentinel, and \SG@doiTail becomes a macro
% whose body is a single \SG@doiSentinel token -- identical to
% \SG@doiSentinelBody, so \ifx compares equal and the "false" branch fires.
\def\SG@doiSentinel{}%
\def\SG@doiSentinelBody{\SG@doiSentinel}%
\long\def\SG@ifhasDoiOrg#1{%
  \long\def\SG@doiScan##1doi.org##2\SG@doiEnd{\def\SG@doiTail{##2}}%
  \SG@doiScan#1doi.org\SG@doiSentinel\SG@doiEnd
  \ifx\SG@doiTail\SG@doiSentinelBody
    \expandafter\@secondoftwo
  \else
    \expandafter\@firstoftwo
  \fi
}
\renewenvironment{APACrefURL}[1][]{%
  \def\SG@refurlDate{#1}%
  \let\SG@origurl\url
  \def\url##1{%
    \SG@ifhasDoiOrg{##1}{}{%
      \ifx\SG@refurlDate\@empty
        \BRetrievedFrom
      \else
        \BRetrieved{\SG@refurlDate}%
      \fi
      \SG@origurl{##1}%
    }%
  }%
}{}
\makeatother

