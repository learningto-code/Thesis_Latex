\usepackage{makeidx} % for making an index
\makeindex

% note that the glossaries package is currently unsuccessful with the current settings, so datagidx has been used; the input TeX files contains the different ''glossary'' items
\usepackage[optimize=low]{datagidx}
\newgidx{abbreviation}{Abbreviations}
\newgidx{notation}{Notation}
\newgidx{glossary}{Glossary}
\input{abbreviation.tex}
\input{notation.tex}
\input{glossary.tex}
% \glsadd{...} markers in the chapters are inherited from an earlier
% datagidx integration that pointed every marker at whichever DB was the
% default at load time. Because abbreviation.tex, notation.tex, and
% glossary.tex each reset the default DB (\DTLgidxSetDefaultDB), a
% \glsadd{X} call issued from a chapter cannot know which DB owns X, and
% the datagidx fallback prints the raw label (e.g. \emph{not:xt}) into the
% body text when the lookup misses. Since the paper renders its notation,
% abbreviation, and glossary lists directly from the \newterm definitions
% and does not depend on the inline \glsadd markers to populate them, the
% safest and least-intrusive fix is to make \glsadd a silent no-op: the
% chapter markers stay in the source for future migration to a
% single-DB glossary system, and no stray labels reach the printed body.
\renewcommand*{\glsadd}[1]{}

